{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/blog", "destination": "/blog/", "permanent": true },
    { "source": "/room", "destination": "/room/", "permanent": true }
  ],
  "headers": [
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/site-version.json", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/room/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
